/* File: angband.rc */

/*
 * If the windows command to compile this file understands #ifdef's, please
 * say #ifdef ALLOW_QUITTING to select from "A&bort" and "Sh&ow scores"
 */

ANGBAND MENU 
{
 POPUP "&File"
 {
  MENUITEM "&Save", 110
  MENUITEM SEPARATOR
  MENUITEM "S&how score", 120
  /*MENUITEM "A&bort", 120*/
  MENUITEM "E&xit", 121
 }

 /*
  * TomeTik: menú "Action" (acciones del juego, jugable con ratón). El ID de cada
  * item es 2000 + el codigo ASCII de la tecla del comando; process_menus() manda
  * esa tecla al term. Replica del menu Action de GTK2/OmnibandTk.
  */
 POPUP "&Action"
 {
  POPUP "Movement"
  {
   MENUITEM "Go down (>)", 2062
   MENUITEM "Go up (<)", 2060
   MENUITEM "Run (.)", 2046
   MENUITEM "Walk and pick up (;)", 2059
   MENUITEM "Walk (-)", 2045
  }
  POPUP "Alter"
  {
   MENUITEM "Alter (+)", 2043
   MENUITEM "Open (o)", 2111
   MENUITEM "Close (c)", 2099
   MENUITEM "Disarm (D)", 2068
   MENUITEM "Bash (B)", 2066
   MENUITEM "Tunnel (T)", 2084
  }
  POPUP "Looking"
  {
   MENUITEM "Look (l)", 2108
   MENUITEM "Locate (L)", 2076
   MENUITEM "Full map (M)", 2077
   MENUITEM "Target (*)", 2042
  }
  POPUP "Searching"
  {
   MENUITEM "Search (s)", 2115
   MENUITEM "Toggle search mode (S)", 2083
  }
  POPUP "Resting"
  {
   MENUITEM "Rest (R)", 2082
   MENUITEM "Stay and pick up (,)", 2044
   MENUITEM "Stay (g)", 2103
  }
  MENUITEM SEPARATOR
  MENUITEM "Take note (:)", 2058
 }

